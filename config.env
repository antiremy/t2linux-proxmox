# Proxmox kernel packaging repo (git://git.proxmox.com/git/pve-kernel.git)
# check-upstream.sh follows release commits on this branch
PVE_KERNEL_BRANCH=master
PVE_KERNEL_VERSION=7.0.14-30
PVE_KERNEL_REF=1cc9d3c72dff80f433cf090707c52c477d920540

# t2linux patches (https://github.com/t2linux/linux-t2-patches)
# 7ee7d19 = last commit made for Linux 7.0
T2_PATCHES_REF=7ee7d19c38e5df31a386b2a0c35ca8f064003960

# t2linux patches to leave out (MacBookPro15,1 only, does not apply)
T2_SKIP="2008-i915-4-lane-quirk-for-mbp15-1.patch"

# Newer t2linux patches to add, as <commit>:<file>
# 9003: Bluetooth on the 2019 Mac Pro (MacPro7,1)
T2_EXTRA="89038d99b674536664201d5a7e21a6096a2a3ff2:9003-Bluetooth-Enable-internal-controller-on-MacPro7-1.patch"

# Added to the end of the kernel name: 7.0.14-30-pve-t2
KERNEL_SUFFIX=-t2

# Bump when rebuilding the same Proxmox kernel with changed t2 patches.
# Reset to 1 when PVE_KERNEL_REF changes. Package version: 7.0.14-30+t2.1
T2_REL=1
